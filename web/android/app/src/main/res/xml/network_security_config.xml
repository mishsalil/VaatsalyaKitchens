<?xml version="1.0" encoding="utf-8"?>
<!--
  Android blocks cleartext HTTP by default, which is right: production traffic
  must be HTTPS and nothing here relaxes that.

  The exceptions are the two addresses that mean "the machine running the dev
  server". 10.0.2.2 is how the Android emulator reaches its host's loopback —
  `localhost` inside the emulator is the emulator itself, not your PC — and
  localhost covers a device tunnelled with `adb reverse`. Both are unroutable
  from anywhere else, so allowing them costs nothing in production.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
